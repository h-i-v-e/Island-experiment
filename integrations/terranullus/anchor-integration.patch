+using System;
+using System.IO;
+using System.Reflection;
+using System.Text;
+using Motu.Gameplay;
+using UnityEditor;
+using UnityEngine;
+
+public static class ShipAnchoringValidation
+{
+    public const string ReportPath = "/tmp/terranullus-ship-anchoring.txt";
+
+    [MenuItem("Island/Validate Furled Sail Anchoring")]
+    public static void Run()
+    {
+        if (EditorApplication.isPlayingOrWillChangePlaymode)
+            throw new InvalidOperationException("Stop Play mode before validating the isolated ship prefab.");
+        var report = new StringBuilder();
+        var root = PrefabUtility.LoadPrefabContents("Assets/Prefabs/ExplorerShip.prefab");
+        try
+        {
+            var ship = root.GetComponentInChildren<ShipController>(true);
+            var anchor = ship.GetComponent<ShipAnchor>();
+            var body = ship.GetComponent<Rigidbody>();
+            Check(anchor != null && anchor.enabled, "Explorer prefab has an enabled bow anchor on its physics body", report);
+            var settings = new SerializedObject(anchor);
+            var bow = settings.FindProperty("bowLocalPosition").vector3Value;
+            Check(bow.z > 10f && bow.y > 3f, "Rode exits the bow above the resting waterline", report);
+            Check(settings.FindProperty("maximumCatchDepthMetres").floatValue == 10f,
+                "Only terrain seabed within ten metres can catch the anchor", report);
+            Check(settings.FindProperty("rodeAngleDegrees").floatValue == 45f,
+                "Prefab pays out a 45-degree rode", report);
+            Check(settings.FindProperty("windwardTurnRateDegrees").floatValue > 0f,
+                "Furled ship has slow wind-source turning assistance even before the rode becomes taut", report);
+            var audio = ship.GetComponent<ShipAnchorAudio>();
+            Check(audio != null && audio.enabled, "Explorer prefab has anchor event audio enabled", report);
+            var audioSettings = new SerializedObject(audio);
+            var drop = audioSettings.FindProperty("dropClip").objectReferenceValue as AudioClip;
+            var bottom = audioSettings.FindProperty("bottomContactClip").objectReferenceValue as AudioClip;
+            var tension = audioSettings.FindProperty("tensionClip").objectReferenceValue as AudioClip;
+            Check(drop != null && bottom != null && tension != null && drop != bottom && drop != tension && bottom != tension,
+                "Three distinct imported clips resolve for drop, bottom contact and first holding load", report);
+            typeof(ShipController).GetMethod("CacheBody", BindingFlags.Instance | BindingFlags.NonPublic).Invoke(ship, null);
+            var controllerForward = (Vector3)typeof(ShipController).GetProperty("Forward", BindingFlags.Instance | BindingFlags.NonPublic).GetValue(ship);
+            var anchorForward = Vector3.ProjectOnPlane(anchor.BowWorldPosition - body.worldCenterOfMass, Vector3.up).normalized;
+            Check(Vector3.Dot(controllerForward, anchorForward) > .99f,
+                "Anchor's physical bow agrees with the Explorer helm's forward axis", report);
+            body.linearVelocity = new Vector3(2f, 0f, 1f);
+            ship.SailsRaised = false;
+            Check(anchor.IsDeployed && Vector3.Distance(anchor.DeploymentPosition, anchor.BowWorldPosition) < .001f,
+                "Furling drops the anchor at the current bow", report);
+            Check(body.linearVelocity == new Vector3(2f, 0f, 1f), "Furling preserves sailing momentum", report);
+            var original = anchor.DeploymentPosition;
+            body.position += Vector3.right * 3f;
+            ship.SetInput(-1f, 0f);
+            Check(anchor.DeploymentPosition == original, "Holding the furl key does not move the original anchor drop", report);
+            ship.SetInput(1f, 0f);
+            Check(!anchor.IsDeployed && !anchor.IsHolding, "Unfurling immediately lifts the anchor", report);
+            ship.SetInput(-1f, 0f);
+            ship.Teleport(new Vector3(20f, body.position.y, 15f));
+            Check(anchor.IsDeployed && Vector3.Distance(anchor.DeploymentPosition, anchor.BowWorldPosition) < .001f,
+                "Explicit teleport redeploys at the destination instead of retaining an old-world constraint", report);
+            Check(ship.GetComponents<ShipAnchor>().Length == 1, "Controller reuses the configured anchor without duplicates", report);
+            report.AppendLine("SUCCESS: Explorer ship furling/anchor integration passed.");
+        }
+        catch (Exception error) { report.AppendLine("FAIL: " + error); Debug.LogException(error); }
+        finally
+        {
+            PrefabUtility.UnloadPrefabContents(root);
+            File.WriteAllText(ReportPath, report.ToString());
+            Debug.Log(report.ToString());
+        }
+    }
+
+    private static void Check(bool condition, string message, StringBuilder report)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+        report.AppendLine("PASS: " + message);
+    }
+}
