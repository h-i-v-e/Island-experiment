<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="studio-root" class="studio-root">
        <uie:Toolbar name="studio-toolbar" class="studio-toolbar">
            <uie:ToolbarButton name="new-button" text="New" />
            <uie:ToolbarButton name="open-button" text="Open" />
            <uie:ToolbarButton name="save-button" text="Save" />
            <uie:ToolbarButton name="save-as-button" text="Save As" />
            <uie:ToolbarButton name="duplicate-button" text="Duplicate" />
            <uie:ToolbarButton name="revert-button" text="Revert" />
            <ui:VisualElement class="toolbar-spacer" />
            <uie:ToolbarButton name="validate-button" text="Validate" />
            <uie:ToolbarButton name="preview-button" text="Preview" />
            <uie:ToolbarButton name="bake-button" text="Bake" />
        </uie:Toolbar>
        <ui:VisualElement name="studio-content" class="studio-content">
            <ui:VisualElement name="left-panel" class="studio-panel left-panel">
                <ui:VisualElement name="layer-list-host" />
                <ui:VisualElement name="layer-actions" class="layer-actions">
                    <ui:Button name="add-layer-button" text="+ Add" />
                    <ui:Button name="duplicate-layer-button" text="Duplicate" />
                    <ui:Button name="delete-layer-button" text="Delete" />
                    <ui:Button name="solo-layer-button" text="Solo" />
                    <ui:Button name="compare-layer-button" text="Before / After" />
                </ui:VisualElement>
                <ui:Foldout name="bake-options" text="Bake options" value="false">
                    <ui:TextField name="output-field" label="Output folder" />
                    <ui:DropdownField name="profile-field" label="Profile" />
                    <ui:Toggle name="replace-toggle" label="Replace Existing Set" />
                    <ui:Toggle name="assign-toggle" label="Assign after import" />
                    <uie:ObjectField name="material-field" label="Material" objectType="UnityEngine.Material" />
                    <ui:DropdownField name="assignment-target" label="Assign as" />
                    <ui:TextField name="baker-executable" label="Release baker" />
                    <ui:Toggle name="cargo-toggle" label="Cargo fallback (manual)" />
                </ui:Foldout>
            </ui:VisualElement>
            <ui:ScrollView name="inspector-panel" class="studio-panel inspector-panel">
                <ui:Label text="Inspector" class="panel-heading" />
                <uie:Toolbar name="inspector-tabs" class="inspector-tabs">
                    <uie:ToolbarButton name="base-inspector-tab" text="Base" class="inspector-tab" />
                    <uie:ToolbarButton name="layer-inspector-tab" text="Selected layer" class="inspector-tab" />
                </uie:Toolbar>
                <ui:VisualElement name="base-inspector" />
                <ui:VisualElement name="layer-inspector" />
            </ui:ScrollView>
            <ui:VisualElement name="preview-host" class="studio-panel preview-host" />
        </ui:VisualElement>
        <ui:VisualElement name="diagnostics-panel" class="diagnostics-panel">
            <ui:Label name="document-label" />
            <ui:Label name="status-label" />
            <ui:ScrollView name="diagnostics-list" class="diagnostics-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
