.studio-root {
    min-width: 980px;
    min-height: 620px;
    flex-grow: 1;
    background-color: rgb(37, 37, 37);
}
.studio-toolbar { height: 28px; flex-shrink: 0; }
.toolbar-spacer { flex-grow: 1; }
.studio-content { flex-grow: 1; flex-direction: row; min-height: 380px; }
.studio-panel { border-right-width: 1px; border-right-color: rgb(65, 65, 65); padding: 6px; }
.left-panel { width: 245px; min-width: 200px; }
.inspector-panel { width: 355px; min-width: 300px; }
.inspector-tabs { margin-bottom: 6px; }
.inspector-tab { flex-grow: 1; }
.inspector-tab-active { color: rgb(255, 255, 255); background-color: rgb(65, 100, 135); }
.preview-host { flex-grow: 1; min-width: 320px; border-right-width: 0; }
.panel-heading { -unity-font-style: bold; margin-bottom: 6px; color: rgb(230, 230, 230); }
.layer-stack { flex-grow: 1; min-height: 180px; }
.layer-row { flex-direction: row; align-items: center; min-height: 36px; padding-left: 3px; padding-right: 3px; }
.layer-row:hover { background-color: rgba(100, 140, 190, 0.18); }
.layer-enabled { width: 20px; margin-right: 3px; }
.layer-name { flex-grow: 1; min-width: 55px; margin-right: 4px; }
.layer-edit { width: 38px; margin-left: 1px; margin-right: 2px; padding-left: 2px; padding-right: 2px; }
.layer-badge { width: 17px; height: 17px; margin-left: 2px; margin-right: 1px; -unity-text-align: middle-center; color: rgb(130, 130, 130); background-color: rgb(55, 55, 55); }
.layer-badge-active { color: rgb(255, 255, 255); background-color: rgb(55, 115, 80); }
.layer-warning { width: 17px; height: 17px; margin-left: 2px; -unity-text-align: middle-center; color: rgb(100, 100, 100); background-color: rgb(55, 55, 55); }
.layer-warning-visible { color: rgb(255, 220, 80); background-color: rgb(110, 75, 30); }
.layer-actions { flex-direction: row; flex-wrap: wrap; margin-top: 5px; }
.layer-actions > Button { width: 46%; flex-grow: 1; margin: 2px; }
.inspector-section { padding-bottom: 6px; }
.inspector-foldout { margin-top: 4px; margin-bottom: 2px; }
.property-row { flex-direction: row; align-items: center; }
.property-label { width: 105px; margin-right: 4px; }
.property-row > FloatField { flex-grow: 1; margin-left: 2px; }
.property-field { margin-top: 2px; margin-bottom: 2px; }
.inspector-note { margin-top: 8px; }
.preview-panel { flex-grow: 1; }
.preview-settings { flex-direction: row; flex-wrap: wrap; align-items: center; min-height: 22px; margin-bottom: 4px; }
.preview-settings > * { margin-right: 5px; }
.preview-popup { width: 150px; }
.preview-popup-wide { width: 210px; }
.preview-slider { width: 180px; }
.preview-tab { padding-left: 5px; padding-right: 5px; }
.preview-tab-active { color: rgb(255, 255, 255); background-color: rgb(65, 100, 135); }
.preview-image-host { flex-grow: 1; align-items: center; justify-content: center; min-height: 260px; overflow: hidden; }
.preview-tile-grid { flex-direction: row; flex-wrap: wrap; }
.preview-tile-grid > Image { margin: 1px; }
.preview-comparison { flex-direction: row; align-items: flex-start; }
.preview-comparison > VisualElement { margin-left: 3px; margin-right: 3px; }
.diagnostics-panel { min-height: 54px; max-height: 155px; flex-shrink: 0; padding: 5px 8px; background-color: rgb(31, 31, 31); }
.diagnostics-list { max-height: 90px; }
.diagnostic-error { color: rgb(255, 130, 130); }
.diagnostic-warning { color: rgb(255, 215, 110); }
